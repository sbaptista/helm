#!/bin/bash

set -euo pipefail
set +x
umask 077

readonly secret_root="/Users/developer/Project-secrets"
readonly secret_dir="$secret_root/helm-secrets"
readonly plaintext_file="$secret_dir/.env.local"
readonly encrypted_file="$secret_dir/helm.env.enc"

# Same names helm-dev requires. ANTHROPIC_API_KEY is optional and
# BYPASS_AUTH_USER_ID is deliberately not required (Stan, 2026-10-21).
required_secrets=(
  NEXT_PUBLIC_SUPABASE_URL
  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
  SUPABASE_SECRET_KEY
  GOOGLE_CLIENT_ID
  GOOGLE_CLIENT_SECRET
  GOOGLE_REDIRECT_URI
)

fail() {
  printf 'helm-secrets-seal: %s\n' "$*" >&2
  exit 1
}

validate_names() {
  local source="$1"
  local name=""
  local missing=()

  for name in "${required_secrets[@]}"; do
    /usr/bin/awk -F= -v wanted="$name" '$1 == wanted && length($0) > length(wanted) + 1 { found=1 } END { exit !found }' "$source" || missing+=("$name")
  done
  if (( ${#missing[@]} > 0 )); then
    fail "source is missing required secret names: ${missing[*]}"
  fi
}

main() {
  local encrypted_tmp=""
  local verification_tmp=""
  local remove_plaintext=0

  case "${1:-}" in
    "") ;;
    --remove-plaintext) remove_plaintext=1 ;;
    *) fail "usage: helm-secrets-seal [--remove-plaintext]" ;;
  esac

  [[ -f "$plaintext_file" ]] || fail "plaintext source is missing: $plaintext_file"
  [[ ! -L "$plaintext_file" ]] || fail "plaintext source must not be a symlink"
  [[ "$(/usr/bin/stat -f '%Su' "$plaintext_file")" == "$(/usr/bin/id -un)" ]] || fail "plaintext source is not owned by the current user"
  validate_names "$plaintext_file"

  /bin/chmod 700 "$secret_root" "$secret_dir"
  /bin/chmod 600 "$plaintext_file"

  encrypted_tmp="$(/usr/bin/mktemp "$secret_dir/helm.env.enc.tmp.XXXXXX")"
  verification_tmp="$(/usr/bin/mktemp "$secret_dir/helm.env.verify.tmp.XXXXXX")"
  trap '/bin/rm -f "$encrypted_tmp" "$verification_tmp"' EXIT

  printf 'helm-secrets-seal: choose the passphrase used by helm-dev (not Orb'\''s).\n'
  /opt/homebrew/bin/openssl enc -aes-256-cbc -pbkdf2 -iter 210000 -salt -in "$plaintext_file" -out "$encrypted_tmp"

  printf 'helm-secrets-seal: re-enter the passphrase to verify the encrypted copy.\n'
  /opt/homebrew/bin/openssl enc -d -aes-256-cbc -pbkdf2 -iter 210000 -in "$encrypted_tmp" -out "$verification_tmp"
  /usr/bin/cmp -s "$plaintext_file" "$verification_tmp" || fail "encrypted-copy verification failed"

  /bin/mv "$encrypted_tmp" "$encrypted_file"
  /bin/chmod 600 "$encrypted_file"
  /bin/rm -f "$verification_tmp"
  trap - EXIT

  printf '\nEncrypted Helm environment created and verified:\n  %s\n' "$encrypted_file"
  if (( remove_plaintext == 1 )); then
    /bin/rm -f "$plaintext_file"
    printf 'The plaintext source was removed as requested.\n'
  else
    printf 'The plaintext file still exists so this operation is recoverable.\n'
    printf 'Run again with --remove-plaintext only after you have verified the encrypted copy.\n'
  fi
}

main "$@"
