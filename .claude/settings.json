      "Bash(more *Project-secrets*)",
      "Bash(grep *.env.local*)",
      "Bash(grep *Project-secrets*)",
      "Bash(rg *.env.local*)",
      "Bash(rg *Project-secrets*)",
      "Bash(sed *.env.local*)",
      "Bash(sed *Project-secrets*)",
      "Bash(awk *.env.local*)",
      "Bash(awk *Project-secrets*)",
      "Bash(cut *.env.local*)",
      "Bash(cut *Project-secrets*)",
      "Bash(strings *.env.local*)",
      "Bash(strings *Project-secrets*)",
